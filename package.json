{
  "name": "personal-vault-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "desktop:stage": "node scripts/build-desktop.mjs --stage-only",
    "desktop:pack": "node scripts/build-desktop.mjs --dir",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "electron .",
    "test:desktop": "node scripts/test-desktop.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "canvas": "^3.2.3",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "next": "^16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "org.personalaisystems.vault",
    "productName": "Personal Vault",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".desktop-stage/web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".desktop-stage/vault",
        "to": "vault",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".desktop-stage/build-info.json",
        "to": "build-info.json",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Personal Vault",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": false,
    "afterPack": "desktop/after-pack.cjs",
    "afterSign": "desktop/notarize.cjs"
  },
  "description": "Local-first Personal Vault desktop app"
}
